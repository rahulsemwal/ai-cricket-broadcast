# Google Gemini API Key for AI commentary and analysis
GEMINI_API_KEY=your_gemini_api_key

# CricAPI Key for real-time cricket match data
CRIC_API_KEY=your_cric_api_key

# Port on which the Express server will run
PORT=3000

# Toggle Gemini AI calls: set to 'true' to use real AI, 'false' for mock AI responses
USE_GEMINI=true

# Toggle Match Data source: set to 'true' to use simulated match data, 'false' for live API data
USE_MOCK_MATCH_DATA=false